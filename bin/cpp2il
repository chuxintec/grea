#!/bin/sh
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export DOTNET_ROOT="${DOTNET_ROOT:-$(brew --prefix dotnet@8)/libexec}"
export DOTNET_BUNDLE_EXTRACT_BASE_DIR="${DOTNET_BUNDLE_EXTRACT_BASE_DIR:-$root/.cache/dotnet-bundle}"
mkdir -p "$DOTNET_BUNDLE_EXTRACT_BASE_DIR"
exec "$root/.private/providers/il2cpp/Cpp2IL/Cpp2IL-2022.1.0-pre-release.21-OSX-ARM64-adhoc" "$@"

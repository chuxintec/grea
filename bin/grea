#!/bin/sh
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -x "$root/runtime/bin/python3" ]; then
  exec "$root/plugin/launcher/grea" "$@"
fi
if [ ! -x "$root/.venv/bin/python" ]; then
  printf '%s\n' "grea runtime missing. Run: uv sync --project $root --frozen" >&2
  exit 2
fi
export GREA_HOME="$root"
exec "$root/.venv/bin/python" "$root/launch.py" "$@"

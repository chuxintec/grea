include LICENSE
include README.md
include THIRD-PARTY-NOTICES.md
recursive-include docs *.md *.json
recursive-include src/monkey/licenses *.txt
recursive-include src/monkey/targets *.cs *.cs.meta *.js
recursive-include src/monkey/sources *.cjs
prune .private
prune outputs
prune dist
recursive-include src/monkey *.cjs

include engineering/LICENSE
recursive-include engineering/src/beaver *.py *.cs *.m *.md *.template *.txt
graft engineering/src/beaver/server_templates
recursive-include engineering/docs *.md *.json
prune engineering/.private
global-exclude __pycache__ *.py[cod] .DS_Store

include scripts/install_release.py

include scripts/smoke_cli.py
include scripts/release_neutral_fixture.py
recursive-include src/monkey/extensions *.json *.cs

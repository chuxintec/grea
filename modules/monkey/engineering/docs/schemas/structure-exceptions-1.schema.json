{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "structure-exceptions-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "ruleId",
          "scope",
          "reason",
          "alternativeConstraint",
          "validation",
          "owner",
          "reviewTrigger"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^Assets/",
            "minLength": 8
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "path",
              "subtree"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "alternativeConstraint": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reviewTrigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

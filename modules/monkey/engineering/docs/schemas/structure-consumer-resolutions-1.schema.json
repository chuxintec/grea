{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "structure-consumer-resolutions-1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resolutions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^Assets/.*\\.cs$"
          },
          "fileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "span": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "literal": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "source-identity-comparison"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "fileSha256",
          "span",
          "literal",
          "kind",
          "reason",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "resolutions"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Explicit binary provider identity; runtime host/path/inventory checks also required",
  "required": [
    "schemaVersion",
    "contract",
    "provider",
    "version",
    "sourceCommit",
    "target",
    "entrypoint",
    "capabilitiesSha256",
    "capabilitiesProjection",
    "files",
    "sourceBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "grea-binary-provider/1"
    },
    "provider": {
      "enum": [
        "monkey",
        "beaver"
      ]
    },
    "version": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "const": {
        "system": "Darwin",
        "architecture": "arm64"
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "capabilitiesSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilitiesProjection": {
      "enum": [
        "monkey-capabilities/1",
        "beaver-capabilities-stable/1"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          }
        }
      }
    },
    "sourceBoundary": {
      "type": "object",
      "description": "Evidence for separate helper/template and embedded source audit; declaration alone is not approval."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "monkey"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "const": "0.7.0"
          },
          "sourceCommit": {
            "enum": [
              "86d47f35744a5af91614c417b00c8eaa2345baad"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "beaver"
          }
        }
      },
      "then": {
        "properties": {
          "version": {
            "const": "0.6.0"
          },
          "sourceCommit": {
            "enum": [
              "1074816d0e4c22940dea415754e587a6e8d29c3d"
            ]
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "layer": {
            "enum": [
              "source",
              "cache",
              "cdn",
              "chunk",
              "export",
              "build",
              "capture"
            ]
          },
          "variant": {
            "type": "string",
            "maxLength": 128
          },
          "payload": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 100000
    }
  }
}

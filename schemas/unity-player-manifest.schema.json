{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "source_sha256",
    "platform",
    "backend",
    "assemblies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "backend": {
      "enum": [
        "Mono",
        "IL2CPP"
      ]
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beaver-result/1 envelope checked for fixed 0.3 candidates07/08; engineering data remains provider-owned",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "operationId",
    "producer",
    "status",
    "actualChanges",
    "artifacts",
    "diagnostics",
    "limitations",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "beaver-result/1"
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "implementationSha256"
      ],
      "properties": {
        "name": {
          "const": "beaver"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "blocked",
        "failed",
        "not_run"
      ]
    },
    "data": {
      "type": "object"
    },
    "actualChanges": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "native",
        "player",
        "visual",
        "business"
      ],
      "properties": {
        "native": {
          "type": [
            "string",
            "object"
          ]
        },
        "player": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "business": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beaver:additive-intake:1",
  "title": "Beaver additive Unity intake specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "candidateManifestSha256",
    "additions",
    "externalScripts",
    "omittedCompilerInputs",
    "verifications",
    "protectedAssets",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "additive-intake"},
    "candidateManifestSha256": {"$ref": "#/$defs/sha256"},
    "additions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/addition"}
    },
    "externalScripts": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalScript"}
    },
    "omittedCompilerInputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/omittedCompilerInput"}
    },
    "verifications": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/verification"}
    },
    "protectedAssets": {
      "type": "array",
      "items": {"$ref": "#/$defs/protectedAsset"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^Assets/.+$"
    },
    "assembly": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nonzeroInt64": {
      "$ref": "#/$defs/int64",
      "not": {"const": 0}
    },
    "addition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/assetPath"},
        "target": {"$ref": "#/$defs/assetPath"}
      }
    },
    "externalScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "sourceGuid", "sourceType", "sourceAssembly", "target",
        "targetGuid", "targetType", "targetAssembly", "targetLocalId",
        "targetSha256", "targetMetaSha256", "reason"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/assetPath"},
        "sourceGuid": {"$ref": "#/$defs/guid"},
        "sourceType": {"type": "string", "minLength": 1},
        "sourceAssembly": {"$ref": "#/$defs/assembly"},
        "target": {"$ref": "#/$defs/assetPath"},
        "targetGuid": {"$ref": "#/$defs/guid"},
        "targetType": {"type": "string", "minLength": 1},
        "targetAssembly": {"$ref": "#/$defs/assembly"},
        "targetLocalId": {"$ref": "#/$defs/nonzeroInt64"},
        "targetSha256": {"$ref": "#/$defs/sha256"},
        "targetMetaSha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "omittedCompilerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "coveredByExternalScript"],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "reason": {"type": "string", "minLength": 1},
        "coveredByExternalScript": {"$ref": "#/$defs/assetPath"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "objects"],
      "properties": {
        "asset": {"$ref": "#/$defs/assetPath"},
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/owner"}
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localId", "type", "assembly", "name", "fields"],
      "properties": {
        "localId": {"$ref": "#/$defs/nonzeroInt64"},
        "type": {"type": "string", "minLength": 1},
        "assembly": {"$ref": "#/$defs/assembly"},
        "name": {"type": "string"},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "objectReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["guid", "localId", "type", "assembly"],
          "properties": {
            "guid": {"const": ""},
            "localId": {"const": 0},
            "type": {"const": ""},
            "assembly": {"const": ""}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["guid", "localId", "type", "assembly"],
          "properties": {
            "guid": {"$ref": "#/$defs/guid"},
            "localId": {"$ref": "#/$defs/nonzeroInt64"},
            "type": {"type": "string", "minLength": 1},
            "assembly": {"$ref": "#/$defs/assembly"}
          }
        }
      ]
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath", "kind", "value"],
          "properties": {
            "propertyPath": {"type": "string", "minLength": 1},
            "kind": {"const": "integer"},
            "value": {"$ref": "#/$defs/int64"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath", "kind", "value"],
          "properties": {
            "propertyPath": {"type": "string", "minLength": 1},
            "kind": {"const": "float"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath", "kind", "value"],
          "properties": {
            "propertyPath": {"type": "string", "minLength": 1},
            "kind": {"const": "boolean"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath", "kind", "value"],
          "properties": {
            "propertyPath": {"type": "string", "minLength": 1},
            "kind": {"const": "string"},
            "value": {"type": "string", "maxLength": 16384}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath", "kind", "value"],
          "properties": {
            "propertyPath": {"type": "string", "minLength": 1},
            "kind": {"const": "object"},
            "value": {"$ref": "#/$defs/objectReference"}
          }
        }
      ]
    },
    "protectedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "metaSha256"],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "metaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/.*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

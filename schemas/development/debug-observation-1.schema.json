{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hash-bound debug observation-root binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "rootArgument"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "contract": {
      "const": "beaver-debug-observation/1"
    },
    "rootArgument": {
      "type": "string",
      "pattern": "^-(?:evidenceRoot|observationRoot|[A-Za-z][A-Za-z0-9_]{0,47}(?:EvidenceRoot|ObservationRoot))$",
      "not": {
        "pattern": "\\s"
      }
    },
    "expectedBundleIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,254}$",
      "not": {
        "pattern": "\\s"
      }
    }
  }
}

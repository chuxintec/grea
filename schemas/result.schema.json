{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "grea"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": ""
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "description": ""
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": ""
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object"
    },

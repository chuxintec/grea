      "required": [
        "schemaVersion",
        "standardVersion",
        "plannerVersion",
        "mode",
        "profileSha256",
        "snapshotSha256",
        "scope",
        "inventory",
        "findings",
        "checks",
        "capability",
        "staticStatus",
        "compliance",
        "limitations"
      ],
      "additionalProperties": false

        "compliance": {
          "const": "not_assessed"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        }

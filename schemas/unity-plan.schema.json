{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "standardVersion": {
      "const": "1.0.0"
    },
    "plannerVersion": {
      "const": "1.0.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "new",
        "adopt",
        "refactor"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "profileSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputsSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[0-9a-f]{64}$"
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "kind": {
              "type": "string",
              "enum": [
                "file",
                "directory"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "guid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "kind",
            "bytes",
            "sha256",
            "guid"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "review",
              "preserve"
            ]
          },
          "logicalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expectedBeforeHash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "seed-once",
              "generated",
              "human",
              "package"
            ]
          },
          "preserveGuid": {
            "type": "boolean"
          },
          "requiredBindings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "validationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          }

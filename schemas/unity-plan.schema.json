              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "not_run",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "capability": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "staticPlanning": {
              "type": "string",
              "enum": [
                "supported",
                "unsupported"
              ]
            },
            "editor": {
              "const": "not_run"

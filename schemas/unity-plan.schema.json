          "action",
          "logicalId",
          "target",
          "expectedBeforeHash",
          "owner",
          "preserveGuid",
          "requiredBindings",
          "reason",
          "validationIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "generationReady": {
      "const": false
    },
    "report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "standardVersion": {
          "const": "1.0.0"
        },
        "plannerVersion": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "new",
            "adopt",
            "refactor"
          ]
        },
        "profileSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshotSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "guid": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "kind",
              "bytes",
              "sha256",
              "guid"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "code",
              "severity",
              "path",
              "message",
              "ruleId"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",

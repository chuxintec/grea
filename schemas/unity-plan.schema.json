  "required": [
    "schemaVersion",
    "standardVersion",
    "plannerVersion",
    "planId",
    "mode",
    "projectId",
    "profileSha256",
    "snapshotSha256",
    "inputsSha256",
    "template",
    "scope",
    "baseline",
    "items",
    "blockers",
    "generationReady",
    "report"
